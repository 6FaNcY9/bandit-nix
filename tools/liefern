#!/usr/bin/env bash
# liefern: one queue for the owner's deploy scripts. Sessions add them, the owner runs them all with one command.
#   liefern add SKRIPT "Satz"   queue SKRIPT with one sentence in simple German (order = order of adding)
#   liefern                     show the queue, ask once, run each script in this terminal, stop at the first error
#   liefern -n                  show the queue only
# The scripts keep their own gpg/finger/sudo prompts; nothing here signs or deploys by itself.
# Queue: $LIEFERN_DIR (default ~/.local/state/liefern): warten/<ns>.eintrag = script path + sentence.
# Done entries move to fertig/<date>-<name>.eintrag; a loose script directly in ~ moves along, others stay.
set -euo pipefail
dir=${LIEFERN_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/liefern}
mkdir -p "$dir/warten" "$dir/fertig"
shopt -s nullglob

list() {
  q=("$dir"/warten/*.eintrag) # the names are nanoseconds: the glob's order is the order of adding
  if ((${#q[@]} == 0)); then
    echo "Nichts zu liefern."
    return 1
  fi
  local i=0 e
  for e in "${q[@]}"; do
    i=$((i + 1))
    printf '%d. %s\n' "$i" "$(sed -n 2p "$e")"
  done
}

case "${1:-}" in
add)
  [[ $# == 3 && -f $2 && -n $3 ]] || {
    echo 'Aufruf: liefern add SKRIPT "Satz" (das Skript muss es geben, der Satz darf nicht leer sein)' >&2
    exit 2
  }
  s=$(realpath -- "$2")
  q=("$dir"/warten/*.eintrag)
  for e in "${q[@]}"; do
    [[ $(sed -n 1p "$e") != "$s" ]] || {
      echo "Steht schon in der Schlange: $s" >&2
      exit 1
    }
  done
  printf '%s\n%s\n' "$s" "${3//$'\n'/ }" >"$dir/warten/$(date +%s%N).eintrag"
  echo "Eingestellt als Nr. $((${#q[@]} + 1)): $3"
  ;;
-n) list || true ;;
"")
  list || exit 0
  read -r -p "Alles liefern? [j/N] " a || a=
  [[ $a == [jJyY]* ]] || {
    echo "Nichts geliefert."
    exit 0
  }
  n=${#q[@]}
  i=0
  for e in "${q[@]}"; do
    i=$((i + 1))
    s=$(sed -n 1p "$e")
    satz=$(sed -n 2p "$e")
    printf '\n== %d/%d: %s\n   %s\n' "$i" "$n" "$satz" "$s"
    rc=0
    if [[ ! -f $s ]]; then
      why="das Skript gibt es nicht mehr"
      rc=1
    else
      bash "$s" || rc=$?
      why="Exit-Code $rc"
    fi
    if ((rc != 0)); then
      printf '\nSTOPP bei Nr. %d: %s\n   %s (%s)\n' "$i" "$satz" "$s" "$why"
      echo "   Die Ausgabe steht darüber: zeig sie Claude. $((n - i + 1)) bleiben in der Schlange; danach wieder: liefern"
      exit 1
    fi
    stamp=$(date +%F-%H%M)
    name=$(basename "$s")
    # a loose script in ~ is done and goes along (scripts that delete themselves are fine too)
    if [[ -f $s && $(dirname "$s") == "$(realpath -- "$HOME")" ]]; then mv -- "$s" "$dir/fertig/$stamp-$name"; fi
    mv -- "$e" "$dir/fertig/$stamp-$name.eintrag"
  done
  printf '\nAlles geliefert (%d).\n' "$n"
  ;;
*)
  echo 'Aufruf: liefern | liefern -n | liefern add SKRIPT "Satz"' >&2
  exit 2
  ;;
esac
