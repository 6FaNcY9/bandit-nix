#!/usr/bin/env bash
# Try every give command of the /kit menus (hosts/bandit-lab/services/minecraft/kits.nix) on the
# main server, aimed at a player name nobody has: "No player was found" means the item, its
# components and the shulker contents parse. Nothing is given to anyone; prints the failures.
#   tools/minecraft-kit-check [HOST]   (default bandit-lab; needs docker on it, as vino has)
# Goes through the console pipe, not RCON: Minecraft's RCON stalls on commands over ~1.4 kB, and the
# shulker boxes are longer. Each command is preceded by an unknown-command marker so its answer can
# be told apart in the log.
set -euo pipefail

host=${1:-bandit-lab}
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
run=kitcheck$$
nix eval --json --impure --expr \
  "import $root/hosts/bandit-lab/services/minecraft/kits.nix { lib = (builtins.getFlake \"git+file://$root\").inputs.nixpkgs.lib; }" |
  jq -r '[.. | .commands? // empty | .[] | select(startswith("[console] give "))] | unique | to_entries[]
    | "'"$run"'-\(.key)\n" + (.value | sub("^\\[console\\] give %player_name% "; "give @a[name='"$run"'] "))' >"/tmp/$run"
trap 'rm -f "/tmp/$run"' EXIT
n=$(grep -c "^$run-" "/tmp/$run")
echo "checking $n give commands on $host"
# shellcheck disable=SC2029 # $run is expanded here on purpose
ssh "$host" "since=\$(date +%s); docker exec -i -u 1000 minecraft sh -c 'cat > /tmp/minecraft-console-in'; sleep 10
  docker logs --since \$since minecraft 2>&1 | grep -E '$run-[0-9]+<--|No player was found|<--\\[HERE\\]|rror|nknown|nvalid|xpected'" <"/tmp/$run" |
  awk -v run="$run" -v n="$n" -v cmds="/tmp/$run" '
    BEGIN { while ((getline l < cmds) > 0) if (l ~ "^" run "-") { k = substr(l, length(run) + 2); getline cmd[k] < cmds } }
    match($0, run "-[0-9]+<--") { k = substr($0, RSTART + length(run) + 1, RLENGTH - length(run) - 4); seen[k] = 1; cur = k; next }
    /No player was found/ { ok[cur] = 1; next }
    cur != "" && !(cur in ok) { why[cur] = why[cur] $0 "\n" }
    END {
      bad = 0
      for (k = 0; k < n; k++) if (!(k in ok)) { bad++; printf "FAIL %s\n  %s%s", substr(cmd[k], 1, 200), (k in seen ? "" : "(no answer)\n"), why[k] }
      printf "%d of %d failed\n", bad, n; exit bad > 0
    }'
